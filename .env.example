APP_ENV=local
APP_ADDR=0.0.0.0:8080
APP_TRUSTED_PROXIES=
APP_SHUTDOWN_TIMEOUT=15s
APP_READ_TIMEOUT=15s
APP_READ_HEADER_TIMEOUT=5s
APP_IDLE_TIMEOUT=60s

# Dialect: postgres | mysql | sqlserver
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=blog
DB_PASSWORD=blog
DB_NAME=blog
DB_SSLMODE=disable

# Google Cloud SQL (when set, uses cloud.google.com/go/cloudsqlconn; DB_HOST/PORT/SSLMODE ignored)
# DB_INSTANCE_CONNECTION_NAME=my-project:us-central1:blog-pg-01
# DB_IAM_AUTH_ENABLED=true
# DB_PRIVATE_IP_ENABLED=true
# DB_GOOGLE_CREDENTIALS_SOURCE=workload-identity

DB_POOL_MAX_OPEN=25
DB_POOL_MAX_IDLE=10
DB_POOL_MAX_LIFETIME=30m
DB_POOL_MAX_IDLE_TIME=10m

# Cache engine: redis | valkey (both use the Redis wire protocol).
REDIS_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

APP_SESSION_KEY=replace_with_at_least_32_random_bytes
APP_CSRF_KEY=replace_with_at_least_32_random_bytes
APP_PEPPER=replace_with_random_secret
APP_JWT_ISSUER=blog-api
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=720h

# Media storage via MinIO/S3-compatible storage.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=blog-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/blog-media
S3_DISK=minio
S3_FORCE_PATH_STYLE=true
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_PRESIGN_TTL=15m

# Messaging (Watermill). Leave MESSAGE_BROKER empty to disable worker bus.
# MESSAGE_BROKER=kafka|rabbitmq|googlepubsub
MESSAGE_BROKER=rabbitmq
MESSAGE_TOPIC_PREFIX=blog.
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CONSUMER_GROUP=blog-api
RABBITMQ_URL=amqp://blog:blog@127.0.0.1:5672/
# GOOGLE_PUBSUB_PROJECT_ID=my-project
# GOOGLE_PUBSUB_CREDENTIALS_SOURCE=workload-identity
