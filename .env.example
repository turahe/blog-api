APP_ENV=local
APP_ADDR=0.0.0.0:8080
# Swagger UI at /swagger (defaults on when APP_ENV=local). Set false to disable.
# APP_SWAGGER_ENABLED=true
APP_TRUSTED_PROXIES=
APP_SHUTDOWN_TIMEOUT=15s
APP_READ_TIMEOUT=15s
APP_READ_HEADER_TIMEOUT=5s
APP_IDLE_TIMEOUT=60s
# Concurrent API requests before shedding with 503 + Retry-After; 0 disables.
HTTP_MAX_INFLIGHT=0

# Dialect: postgres | mysql | sqlserver
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=blog
DB_PASSWORD=blog
DB_NAME=blog
DB_SSLMODE=disable

# Google Cloud SQL (when set, uses cloud.google.com/go/cloudsqlconn; DB_HOST/PORT/SSLMODE ignored)
# DB_INSTANCE_CONNECTION_NAME=my-project:us-central1:blog-pg-01
# DB_IAM_AUTH_ENABLED=true
# DB_PRIVATE_IP_ENABLED=true
# DB_GOOGLE_CREDENTIALS_SOURCE=workload-identity

DB_POOL_MAX_OPEN=25
DB_POOL_MAX_IDLE=10
DB_POOL_MAX_LIFETIME=30m
DB_POOL_MAX_IDLE_TIME=10m

# Cache engine: redis | valkey (both use the Redis wire protocol).
REDIS_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Public read cache (posts, categories, tags, public user profiles) in Redis. CACHE_ENABLED=false bypasses it
# everywhere; CACHE_BYPASS_HEADER=true lets a request skip it with `Cache-Control: no-cache`
# (debugging only). TTLs are per read family; 0 disables that family.
CACHE_ENABLED=true
CACHE_BYPASS_HEADER=false
CACHE_TTL_POSTS=1m
CACHE_TTL_CATEGORIES=10m
CACHE_TTL_TAGS=10m
CACHE_TTL_USERS=15m
CACHE_TTL_SETTINGS=10m

APP_SESSION_KEY=replace_with_at_least_32_random_bytes
APP_CSRF_KEY=replace_with_at_least_32_random_bytes
APP_PEPPER=replace_with_random_secret
# ES256 access tokens (P-256). Prefer *_PATH; inline PEM via APP_JWT_PRIVATE_KEY / APP_JWT_PUBLIC_KEY also works.
APP_JWT_PRIVATE_KEY_PATH=configs/dev/jwt-es256-private.pem
APP_JWT_PUBLIC_KEY_PATH=configs/dev/jwt-es256-public.pem
# APP_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APP_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
APP_JWT_ISSUER=blog-api
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=720h
AUTH_LOGIN_PER_MINUTE=10
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT=15m
# Fallback Casbin policy reload; role writes also notify other instances over Redis. 0 disables.
RBAC_POLICY_RELOAD_INTERVAL=30s
# 32-byte base64 key that encrypts TOTP secrets at rest and keys backup-code hashes.
# Generate with: openssl rand -base64 32. Empty disables 2FA enrollment; accounts that
# already enrolled then cannot log in (503) until the same key is restored. With MESSAGE_BROKER
# it also encrypts queued emails and audit batches, and is required in production.
APP_ENCRYPTION_KEY=
# Issuer shown in authenticator apps.
AUTH_2FA_ISSUER=Blog
# Social sign-in for existing accounts. A provider is enabled when both its id and secret are set.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Comma-separated client callback URLs, matched exactly (https in production).
OAUTH_REDIRECT_URIS=

# Audit log: days to keep rows (pruned by `app audit prune` and hourly by `app scheduler`) and the
# in-memory queue size for the background writer. With MESSAGE_BROKER and APP_ENCRYPTION_KEY
# the writer publishes batches for `app worker` (audit-writer) instead of inserting them.
AUDIT_RETENTION_DAYS=395
AUDIT_QUEUE_SIZE=1024
# Analytics ingest: requests per minute per client IP (0 = unlimited), events buffered for the
# background writer, and the edge proxy's country header (e.g. CF-IPCountry; needs
# APP_TRUSTED_PROXIES).
ANALYTICS_INGEST_PER_MINUTE=300
ANALYTICS_QUEUE_SIZE=10000
ANALYTICS_COUNTRY_HEADER=
ANALYTICS_EXPORT_RETENTION=72h
ANALYTICS_EXPORT_URL_TTL=15m
# Post full-text search language: a PostgreSQL text search configuration. simple does no
# stemming and suits any language; english, indonesian, ... stem words. After changing it run
# `app search reindex`, then restart app serve.
SEARCH_LANGUAGE=simple

# Staff impersonation (POST /admin/impersonation/start): session and token lifetime, 5m-2h,
# never renewed.
IMPERSONATION_TTL=1h

# Newsletter sending from app worker. smtp and resend send issues through the mail settings
# below; custom_http POSTs each delivery and subscriber change as HMAC-signed JSON to the
# endpoint. Empty follows MAIL_DRIVER. A secret (32+ bytes) also enables the bounce/complaint
# webhook POST /api/v1/newsletter/webhooks/provider with any provider. Sender identity, postal
# address, and lists are set in PUT /api/v1/admin/newsletter/provider-config.
NEWSLETTER_PROVIDER=
NEWSLETTER_HTTP_ENDPOINT=
NEWSLETTER_HTTP_SECRET=
NEWSLETTER_SEND_BATCH=50

# Media storage via RustFS (Compose) / other S3-compatible storage.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=blog-media
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/blog-media
S3_DISK=minio
S3_FORCE_PATH_STYLE=true
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_PRESIGN_TTL=15m
# The media-orphans job deletes soft-deleted assets (row and object) after this; 0 keeps them.
# Uploads never completed are always removed 24h after their presign expired.
MEDIA_PURGE_AFTER=720h
# Personal data exports (GET /me/activity/export) are stored under privacy-exports/ in S3_BUCKET;
# keep that prefix private. Archives are deleted after the retention; download links are short-lived.
PRIVACY_EXPORT_RETENTION=72h
PRIVACY_EXPORT_URL_TTL=15m
# Avatars are uploaded through the API (POST /me/avatar), sniffed, and capped separately.
AVATAR_MAX_BYTES=5242880
# Image transforms (GET /media/{id}/transform) are delegated to imgproxy. Leave IMGPROXY_URL
# empty to answer 501. Key and salt are hex (openssl rand -hex 32) and must match imgproxy's.
# Locally: docker compose --profile imgproxy up -d imgproxy, then IMGPROXY_URL=http://127.0.0.1:8081
IMGPROXY_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=
MEDIA_TRANSFORM_WIDTHS=64,128,256,320,480,640,768,1024,1280,1536,1920
MEDIA_TRANSFORM_URL_TTL=24h

# Comments. Guest comments always start pending; signed-in ones only when approval is required.
COMMENTS_GUEST_ENABLED=false
COMMENTS_REQUIRE_APPROVAL=false
COMMENTS_EDIT_WINDOW=15m
COMMENTS_FLAG_THRESHOLD=3
# Per-caller budgets (user, or client IP for guests); 0 disables the limit.
COMMENTS_CREATE_PER_MINUTE=6
COMMENTS_ACTIONS_PER_MINUTE=30
# Cloudflare Turnstile secret; when set, guest comments need a valid turnstile_response.
TURNSTILE_SECRET_KEY=

# Notification stream (GET /api/v1/me/notifications/stream). Needs MESSAGE_BROKER for
# fan-out across replicas; without it the stream answers 503 and the inbox still works.
SSE_PING_INTERVAL=15s
SSE_MAX_CONCURRENT_PER_USER=3

# Transactional outbox. With MESSAGE_BROKER set, domain events are stored with the change
# that caused them and `app worker` relays them to the broker.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1s
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION=168h

# Worker consumers. A handler error is retried with backoff, then the message goes to the
# blog.dead_letter topic. Handled message ids are kept for the dedupe retention.
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_INTERVAL=1s
CONSUMER_RETRY_MAX_INTERVAL=30s
CONSUMER_DEDUPE_RETENTION=168h
# Handler copies per consumer, and the circuit breaker that pauses a consumer whose
# downstream (SMTP, database) keeps failing. CONSUMER_BREAKER_FAILURES=0 disables it.
CONSUMER_CONCURRENCY=1
CONSUMER_BREAKER_FAILURES=5
CONSUMER_BREAKER_TIMEOUT=30s

# Sentry error tracking + tracing. Leave SENTRY_DSN empty to disable.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=local
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Email. MAIL_DRIVER is smtp or resend. With resend, MAIL_FROM must be on a domain verified
# in Resend and RESEND_API_KEY is required.
MAIL_DRIVER=smtp
MAIL_FROM=Blog <blog@localhost>
RESEND_API_KEY=

# SMTP driver. Empty SMTP_HOST keeps notifications in the log. Compose points the API at Mailpit.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
APP_PUBLIC_URL=http://127.0.0.1:8080

# Prometheus /metrics on a separate listener; empty disables it. The worker also serves
# /healthz and /readyz there.
METRICS_ADDR=

# Messaging (Watermill). Leave MESSAGE_BROKER empty to disable worker bus.
# MESSAGE_BROKER=kafka|rabbitmq|googlepubsub
MESSAGE_BROKER=rabbitmq
MESSAGE_TOPIC_PREFIX=blog.
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CONSUMER_GROUP=blog-api
# Managed Kafka: TLS plus SASL (PLAIN, SCRAM-SHA-256, SCRAM-SHA-512). Production requires
# KAFKA_TLS=true whenever SASL is set.
# KAFKA_TLS=true
# KAFKA_TLS_CA_PATH=
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
RABBITMQ_URL=amqp://blog:blog@127.0.0.1:5672/
# GOOGLE_PUBSUB_PROJECT_ID=my-project
# GOOGLE_PUBSUB_CREDENTIALS_SOURCE=workload-identity
