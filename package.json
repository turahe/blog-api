{
  "name": "blog-api",
  "version": "0.1.0",
  "private": true,
  "description": "Blog Platform REST API — modular OpenAPI 3.1 specification",
  "scripts": {
    "openapi:lint": "redocly lint contracts/openapi.yaml",
    "openapi:preview": "redocly preview contracts/openapi.yaml",
    "openapi:build-docs": "redocly build-docs contracts/openapi.yaml -o dist/openapi.html",
    "openapi:bundle": "redocly bundle contracts/openapi.yaml -o contracts/openapi.bundle.yaml",
    "openapi:split": "echo \"Manual split committed to repo; to re-split from bundle use: redocly split contracts/openapi.bundle.yaml --outDir .\"",
    "contracts:validate": "npm run openapi:lint"
  },
  "devDependencies": {
    "@mermaid-js/parser": "^2.0.0",
    "@redocly/cli": "^2.54.2",
    "jsdom": "^29.1.1",
    "mermaid": "^12.0.0"
  }
}
